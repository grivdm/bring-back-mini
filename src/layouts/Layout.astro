---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Bring Back Mini — Small phone. Big love.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Not everyone wants a bigger iPhone. An independent fan project celebrating compact phones." />
    <meta name="theme-color" content="#f5f5f2" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
