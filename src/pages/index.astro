---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="mx-auto flex min-h-svh max-w-7xl flex-col px-6 sm:px-12">
    <header class="flex items-center justify-between gap-4 py-7">
      <a class="text-lg font-semibold tracking-tight" href={import.meta.env.BASE_URL} aria-label="Bring Back Mini home">Bring Back Mini<span class="text-accent">.</span></a>
      <span class="text-xs text-muted sm:text-sm">An independent fan project</span>
    </header>

    <main class="flex flex-1 flex-col items-center justify-center py-20 text-center">
      <p class="mb-8 text-xs font-semibold tracking-[0.18em] text-muted uppercase">A little phone worth loving</p>
      <h1 class="text-[clamp(3.5rem,12vw,8rem)] leading-[0.96] font-semibold tracking-[-0.065em]">
        Small phone.<br /><span class="text-accent">Big love.</span>
      </h1>
      <p class="mt-8 max-w-md text-lg leading-relaxed text-muted sm:text-xl">Not everyone wants a bigger iPhone.</p>
    </main>

    <footer class="border-t border-ink/10 py-6 text-center text-xs leading-relaxed text-muted sm:text-left">
      Made by people who miss small phones. Not affiliated with Apple.
    </footer>
  </div>
</Layout>
